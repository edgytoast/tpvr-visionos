            token outputs:out
        }

        def Shader "RawUV"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "RawUVSplit"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Root/MirrorBlend_MM/RawUV.outputs:out>
