        def Shader "UV"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1.connect = </Root/MirrorBlend_MM/RawUVSplit.outputs:outx>
            float inputs:in2.connect = </Root/MirrorBlend_MM/FlippedV.outputs:out>
            float2 outputs:out
        }

        def Shader "Sample"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorBlend_MM.inputs:Frame>
