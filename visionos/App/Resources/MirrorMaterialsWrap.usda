        def Shader "ColourWeight"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/MirrorBlend_MM/ColourWeightAlpha.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend_MM.inputs:ColourBase>
            float outputs:out
        }

        def Shader "Weighted"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend_MM/Linear.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend_MM/ColourWeight.outputs:out>
            float3 outputs:out
        }

        def Shader "WeightedKept"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend_MM/Weighted.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend_MM/GlowKeep.outputs:out>
            float3 outputs:out
        }

        def Shader "GlowCovered"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend_MM/GlowRGB.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend_MM/Opacity.outputs:out>
            float3 outputs:out
        }

        def Shader "WeightedGlowing"
        {
            uniform token info:id = "ND_add_vector3"
            float3 inputs:in1.connect = </Root/MirrorBlend_MM/WeightedKept.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorBlend_MM/GlowCovered.outputs:out>
            float3 outputs:out
        }

        def Shader "RGB"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Root/MirrorBlend_MM/WeightedGlowing.outputs:out>
            color3f outputs:out
        }

        def Shader "OpacityFromAlpha"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/MirrorBlend_MM/Alpha.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend_MM.inputs:OpacityAlpha>
            float outputs:out
        }

        def Shader "OpacityFromLuma"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/MirrorBlend_MM/Luma.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend_MM.inputs:OpacityLuma>
            float outputs:out
        }

        def Shader "OpacitySum"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/MirrorBlend_MM/OpacityFromAlpha.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend_MM/OpacityFromLuma.outputs:out>
            float outputs:out
        }

        def Shader "Opacity"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/MirrorBlend_MM/OpacitySum.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend_MM.inputs:OpacityBase>
            float outputs:out
        }
    }
}
