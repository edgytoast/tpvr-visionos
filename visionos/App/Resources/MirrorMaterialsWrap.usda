            uniform bool inputs:no_flip_v = 1
            string inputs:u_wrap_mode = "mirrored_repeat"
            string inputs:v_wrap_mode = "mirrored_repeat"
            float4 outputs:out
        }

        def Shader "SampleSplit"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorBlend_MM/Sample.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "SampleRGB"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorBlend_MM/SampleSplit.outputs:outx>
            float inputs:in2.connect = </Root/MirrorBlend_MM/SampleSplit.outputs:outy>
            float inputs:in3.connect = </Root/MirrorBlend_MM/SampleSplit.outputs:outz>
            float3 outputs:out
        }

        def Shader "SampleGamma"
        {
            uniform token info:id = "ND_power_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend_MM/SampleRGB.outputs:out>
            float inputs:in2 = 0.45454545
            float3 outputs:out
        }

        def Shader "MulColour"
        {
            uniform token info:id = "ND_geomcolor_color4"
            color4f outputs:out
        }

        def Shader "Mul"
        {
            uniform token info:id = "ND_convert_color4_vector4"
            color4f inputs:in.connect = </Root/MirrorBlend_MM/MulColour.outputs:out>
            float4 outputs:out
        }

        def Shader "MulSplit"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorBlend_MM/Mul.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "MulRGB"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorBlend_MM/MulSplit.outputs:outx>
            float inputs:in2.connect = </Root/MirrorBlend_MM/MulSplit.outputs:outy>
            float inputs:in3.connect = </Root/MirrorBlend_MM/MulSplit.outputs:outz>
            float3 outputs:out
        }

        def Shader "AddRG"
        {
            uniform token info:id = "ND_texcoord_vector2"
            uniform int inputs:index = 1
            float2 outputs:out
        }

        def Shader "AddBA"
        {
            uniform token info:id = "ND_texcoord_vector2"
            uniform int inputs:index = 2
            float2 outputs:out
        }

        def Shader "AddRGSplit"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Root/MirrorBlend_MM/AddRG.outputs:out>
            float outputs:outx
            float outputs:outy
        }

        def Shader "AddBASplit"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Root/MirrorBlend_MM/AddBA.outputs:out>
            float outputs:outx
            float outputs:outy
        }

        def Shader "AddRGB"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorBlend_MM/AddRGSplit.outputs:outx>
            float inputs:in2.connect = </Root/MirrorBlend_MM/AddRGSplit.outputs:outy>
            float inputs:in3.connect = </Root/MirrorBlend_MM/AddBASplit.outputs:outx>
            float3 outputs:out
        }

        def Shader "Product"
        {
            uniform token info:id = "ND_multiply_vector3"
            float3 inputs:in1.connect = </Root/MirrorBlend_MM/SampleGamma.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorBlend_MM/MulRGB.outputs:out>
            float3 outputs:out
        }

        def Shader "Sum"
        {
            uniform token info:id = "ND_add_vector3"
            float3 inputs:in1.connect = </Root/MirrorBlend_MM/Product.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorBlend_MM/AddRGB.outputs:out>
            float3 outputs:out
        }

        def Shader "Clamped"
        {
            uniform token info:id = "ND_clamp_vector3FA"
            float3 inputs:in.connect = </Root/MirrorBlend_MM/Sum.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float3 outputs:out
        }

        def Shader "Linear"
        {
            uniform token info:id = "ND_power_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend_MM/Clamped.outputs:out>
            float inputs:in2 = 2.2
            float3 outputs:out
        }

        def Shader "AlphaProduct"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/MirrorBlend_MM/SampleSplit.outputs:outw>
            float inputs:in2.connect = </Root/MirrorBlend_MM/MulSplit.outputs:outw>
            float outputs:out
        }

        def Shader "AlphaSum"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/MirrorBlend_MM/AlphaProduct.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend_MM/AddBASplit.outputs:outy>
            float outputs:out
        }

        def Shader "Alpha"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Root/MirrorBlend_MM/AlphaSum.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
