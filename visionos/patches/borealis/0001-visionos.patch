-#if defined(__APPLE__) && !TARGET_OS_IOS && !TARGET_OS_TV && !TARGET_OS_MACCATALYST
+#if defined(__APPLE__) && !TARGET_OS_IOS && !TARGET_OS_VISION && !TARGET_OS_TV && !TARGET_OS_MACCATALYST
 #define BOREALIS_USE_MACOS_FOLDER_DIALOG 1
 #else
 #define BOREALIS_USE_MACOS_FOLDER_DIALOG 0
@@ -257,7 +257,9 @@ void fail_wrong_thread(Callback callback) {
 }  // namespace detail
 
 Capabilities capabilities() noexcept {
-#if defined(__APPLE__) && TARGET_OS_TV
+#if defined(__APPLE__) && (TARGET_OS_TV || TARGET_OS_VISION)
