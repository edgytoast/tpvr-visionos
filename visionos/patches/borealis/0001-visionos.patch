diff --git a/src/data.cpp b/src/data.cpp
index c9e7007..7806062 100644
--- a/src/data.cpp
+++ b/src/data.cpp
@@ -467,11 +467,14 @@ detail::Environment discover_environment(const AppInfo& appInfo, const Options&
 #if defined(_WIN32)
     environment.isWindows = true;
 #endif
-#if defined(__APPLE__) && TARGET_OS_IOS && !TARGET_OS_TV && !TARGET_OS_MACCATALYST
+#if defined(__APPLE__) && (TARGET_OS_IOS || TARGET_OS_VISION) && !TARGET_OS_TV && !TARGET_OS_MACCATALYST
+    // Apple Vision Pro counts as iOS here: data lives in the app's Documents
+    // folder (visible in the Files app) and the location cannot be changed.
     environment.isIOS = true;
 #endif
 #if defined(_WIN32) ||                                                                             \
-    (defined(__APPLE__) && !TARGET_OS_IOS && !TARGET_OS_TV && !TARGET_OS_MACCATALYST) ||           \
+    (defined(__APPLE__) && !TARGET_OS_IOS && !TARGET_OS_VISION && !TARGET_OS_TV &&                 \
+     !TARGET_OS_MACCATALYST) ||                                                                    \
     (defined(__linux__) && !defined(__ANDROID__))
     environment.canOpenFolder = true;
 #endif
diff --git a/src/file_select/file_select.cpp b/src/file_select/file_select.cpp
index 227eda7..174b088 100644
--- a/src/file_select/file_select.cpp
+++ b/src/file_select/file_select.cpp
@@ -27,7 +27,7 @@
 #define BOREALIS_USE_IOS_FILE_DIALOG 0
