+  }
+  std::shared_ptr<wgpu::SurfaceSourceMetalLayer> visionDesc = std::make_shared<wgpu::SurfaceSourceMetalLayer>();
+  visionDesc->layer = (__bridge void*)layer;
+  return std::move(visionDesc);
+#endif
