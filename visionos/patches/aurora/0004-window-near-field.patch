index b1328cd..0f95d15 100644
--- a/include/aurora/mirror.h
+++ b/include/aurora/mirror.h
@@ -103,8 +103,8 @@ bool enabled() noexcept;
 
 // How far in front of its glass the window showing the frames lets them come out, in window widths
 // (any thread; 0, the default: no limit), and the narrowest half-view tangent it shows as is (a
-// narrower view's depths are compressed to the picture seen from that tangent, which the window's
-// scale of depth has to match). What's nearer than the glass is compressed into the allowance.
+// narrower view's camera is taken to be that close; 0: every view's own). What would come out past
+// the allowance is cut, as a near plane cuts (AURORA_MIRROR_NEAR=ease compresses it instead).
 void set_front_allowance(float widths, float minViewTangent) noexcept;
 
