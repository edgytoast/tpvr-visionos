+      os_sync_wait_on_address(&sWorkerWake, event, sizeof(uint32_t), OS_SYNC_WAIT_ON_ADDRESS_NONE);
+    }
+    sWorkerSleeping.store(0, std::memory_order_seq_cst);
+#else
     sWorkerWake.wait(event, std::memory_order_acquire);
+#endif
   }
 }
 
