 void wake_worker() noexcept {
+#if defined(__APPLE__) && TARGET_OS_VISION
+  if (kKernelWait) {
+    sWorkerWake.fetch_add(1, std::memory_order_seq_cst);
+    if (sWorkerSleeping.load(std::memory_order_seq_cst) != 0) {
+      os_sync_wake_by_address_any(&sWorkerWake, sizeof(uint32_t), OS_SYNC_WAKE_BY_ADDRESS_NONE);
+    }
+    return;
+  }
+#endif
   sWorkerWake.fetch_add(1, std::memory_order_release);
   sWorkerWake.notify_all();
 }
