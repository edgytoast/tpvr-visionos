+#if defined(__APPLE__) && TARGET_OS_VISION
+// visionos/patches/aurora/0003 (the Wind Waker port's 0106): the worker and drain() wait in the
+// kernel. visionOS's libc++ has no native atomic wait (its notify is a no-op and its wait polls,
+// sleeping half as long as it has waited so far, up to 64 ms at a time), so a drain woke late by
+// up to half its wait, and the worker, idle while the game ran its logic, took up to milliseconds
+// to see the next draw. Each side spins briefly first (draws come every few microseconds while the
+// game draws), then sleeps on the address (os_sync_wait_on_address); the other wakes it only when
+// it says it's asleep. visionOS only: other Apple systems' libc++ waits in the kernel already.
+std::atomic<uint32_t> sWorkerSleeping{0};
+std::atomic<uint32_t> sDrainSleeping{0};
+constexpr uint64_t kSpinNanos = 50'000;
+
+uint64_t now_nanos() noexcept { return clock_gettime_nsec_np(CLOCK_UPTIME_RAW); }
+// A test switch: AURORA_FIFO_KERNEL_WAIT=0 waits as before (std::atomic's wait), to compare.
+const bool kKernelWait = [] {
+  const char* value = std::getenv("AURORA_FIFO_KERNEL_WAIT");
+  return value == nullptr || std::strcmp(value, "0") != 0;
+}();
+#endif
